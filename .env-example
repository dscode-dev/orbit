# Banco de Dados — dois papéis, de propósito (PR-26.6)
#
# POSTGRES_USER é o papel **administrativo**: o superusuário que o contêiner do
# Postgres cria. Ele roda migrations, DDL e o provisionamento. É o papel com que
# a aplicação conectava até a PR-26.6 — e por isso nenhuma política de RLS era
# avaliada, já que superusuário tem BYPASSRLS.
#
# APP_DATABASE_* é o papel de **runtime**: criado e reconciliado a cada deploy
# pelo serviço `migrate`, sem SUPERUSER e sem BYPASSRLS. É com ele que a API
# conecta, e é o que torna as 68 tabelas com FORCE ROW LEVEL SECURITY efetivas.
POSTGRES_USER=postgres_saas_user
POSTGRES_PASSWORD=SenhaSuperSegura123
POSTGRES_DB=saas_core_db
POSTGRES_PORT=5432

APP_DATABASE_USER=orbit_app
# Mínimo de 12 caracteres — o provisionamento recusa senha curta.
APP_DATABASE_PASSWORD=replace-with-at-least-12-characters
API_PORT=3001
API_HOST=0.0.0.0
FRONTEND_PORT=3000
# false apenas enquanto o acesso local ocorrer por HTTP; use true com HTTPS.
AUTH_COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:3000
ORBIT_VERSION=latest

# Credencial administrativa — Prisma CLI (`migrate`, `generate`) e scripts.
DATABASE_URL="postgresql://postgres_saas_user:SenhaSuperSegura123@localhost:5432/saas_core_db?schema=public"

# Credencial de runtime — é esta que a API usa. Sem ela, a aplicação cai de
# volta para DATABASE_URL e registra um aviso na subida.
APP_DATABASE_URL="postgresql://orbit_app:replace-with-at-least-12-characters@localhost:5432/saas_core_db?schema=public"
# Em "true", subir com papel que contorna RLS falha em vez de avisar.
DATABASE_ENFORCE_RESTRICTED_ROLE=false

# Transações e pool (PR-26.6.1).
#
# A janela da transação interativa conta tempo de **parede** desde o BEGIN, e o
# processo renderiza PDF de forma síncrona: os 5 s padrão do Prisma estouravam
# por trabalho alheio, e o erro aparecia como falha genérica em outra rota.
# Ver backend/docs/transaction-concurrency.md.
DATABASE_POOL_MAX=20
DATABASE_TRANSACTION_TIMEOUT_MS=20000
DATABASE_TRANSACTION_MAX_WAIT_MS=10000

# Registra 4xx com rota, código e mensagem. Desligado por padrão — 4xx é
# conversa normal com o cliente. Ligue para investigar recusa inesperada.
LOG_CLIENT_ERRORS=false

# Identity
JWT_ACCESS_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=orbit-api
JWT_AUDIENCE=orbit
# Base64-encoded 32-byte key (example: openssl rand -base64 32)
ENCRYPTION_KEY=

# Acesso de teste com todas as permissões (`npm run seed:owner`).
#
# Executado **à mão**, nunca na subida da aplicação: uma conta irrestrita
# nascendo sozinha a cada deploy é o que este script deliberadamente não faz.
# Cria organização, filial matriz, papel OWNER com `*` e um plano próprio de
# acesso completo — inativo, para não aparecer no catálogo público.
OWNER_EMAIL=owner@orbit.local
OWNER_PASSWORD=replace-with-at-least-12-characters
OWNER_FIRST_NAME=Orbit
OWNER_LAST_NAME=Owner
# Opcionais — há padrão para todos.
# OWNER_ORGANIZATION_NAME=Orbit Owner
# OWNER_LEGAL_NAME=Orbit Owner LTDA
# OWNER_DOCUMENT_NUMBER=  # CNPJ; gerado válido quando ausente
# OWNER_CITY=Recife
# OWNER_STREET=Rua da Aurora
# OWNER_STATE_CODE=PE

# Bootstrap idempotente do administrador global (`npm run seed:platform-admin`)
PLATFORM_ADMIN_EMAIL=admin@orbit.local
PLATFORM_ADMIN_PASSWORD=replace-with-at-least-12-characters
PLATFORM_ADMIN_FIRST_NAME=Orbit
PLATFORM_ADMIN_LAST_NAME=Administrator
