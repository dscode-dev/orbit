// -----------------------------------------------------------------------------
// AUDIT
// -----------------------------------------------------------------------------

model AuditLog {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  businessUnitId String?  @map("business_unit_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  action         String   @db.VarChar(120)
  entityType     String   @map("entity_type") @db.VarChar(100)
  entityId       String?  @map("entity_id") @db.Uuid
  requestId      String?  @map("request_id") @db.VarChar(120)
  ipAddress      String?  @map("ip_address") @db.Inet
  userAgent      String?  @map("user_agent") @db.Text
  before         Json?    @db.JsonB
  after          Json?    @db.JsonB
  metadata       Json?    @db.JsonB
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  businessUnit BusinessUnit? @relation(fields: [businessUnitId], references: [id], onDelete: SetNull)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

/// Job assíncrono processado pela própria aplicação.
///
/// O Orbit não adotou fila externa: Postgres é a infraestrutura de mensageria
/// disponível, e `FOR UPDATE SKIP LOCKED` dá exclusão mútua entre réplicas sem
/// acrescentar um componente ao deploy. A tabela é genérica de propósito —
/// renderização é o primeiro uso, não o único previsto.
model BackgroundJob {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  businessUnitId String?   @map("business_unit_id") @db.Uuid
  queue          String    @db.VarChar(80)
  /// Chave de idempotência: enfileirar o mesmo trabalho duas vezes não duplica.
  jobKey         String    @map("job_key") @db.VarChar(200)
  payload        Json      @default("{}") @db.JsonB
  status         String    @default("PENDING") @db.VarChar(20)
  attempts       Int       @default(0)
  maxAttempts    Int       @default(3) @map("max_attempts")
  /// Quando o job volta a ser elegível — é o backoff exponencial.
  availableAt    DateTime  @default(now()) @map("available_at") @db.Timestamptz(3)
  lockedAt       DateTime? @map("locked_at") @db.Timestamptz(3)
  lockedBy       String?   @map("locked_by") @db.VarChar(120)
  /// Atravessa enfileiramento, execução, log e auditoria.
  correlationId  String    @map("correlation_id") @db.VarChar(64)
  /// Contexto do ator, para o worker reabrir a mesma RLS da requisição.
  actorUserId    String?   @map("actor_user_id") @db.Uuid
  lastError      String?   @map("last_error") @db.VarChar(1000)
  startedAt      DateTime? @map("started_at") @db.Timestamptz(3)
  finishedAt     DateTime? @map("finished_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessUnit BusinessUnit? @relation(fields: [businessUnitId], references: [id], onDelete: SetNull)

  @@index([queue, status, availableAt])
  @@index([organizationId, queue, status])
  @@map("background_jobs")
}

// -----------------------------------------------------------------------------
// WORKFORCE
//
// Domínio de gestão de equipe. Complementa `OrganizationMembership`, que
// responde "quem faz parte e com que papel", com o que a operação de campo
// precisa saber: o que a pessoa sabe fazer, o que ela está habilitada a fazer,
// com quem trabalha e onde esteve.
//
// Não substitui autenticação: nada aqui participa de login ou autorização.
// -----------------------------------------------------------------------------

/// Catálogo de especialidades da organização ("Refrigeração", "Elétrica").
/// É catálogo, e não texto livre no membro, para que duas pessoas com a mesma
/// especialidade sejam encontráveis pela mesma chave.
model Specialty {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String    @db.VarChar(120)
  slug           String    @db.VarChar(120)
  description    String?   @db.Text
  /// Classe de cor sobre tokens do Design System, escolhida pela organização.
  color          String?   @db.VarChar(40)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      MemberSpecialty[]

  @@unique([organizationId, slug])
  @@index([organizationId, deletedAt])
  @@map("specialties")
}

/// Especialidade de uma pessoa, com o nível declarado pela organização.
model MemberSpecialty {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  specialtyId    String    @map("specialty_id") @db.Uuid
  /// JUNIOR | PLENO | SENIOR | ESPECIALISTA — declarado, não calculado.
  level          String    @default("PLENO") @db.VarChar(30)
  notes          String?   @db.Text
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialty    Specialty    @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@unique([userId, specialtyId])
  @@index([organizationId, specialtyId, deletedAt])
  @@index([organizationId, userId, deletedAt])
  @@map("member_specialties")
}

/// Certificação de uma pessoa (NR-35, NR-10, curso de fabricante).
///
/// `expiresAt` é o que torna a certificação operacionalmente útil: quem escala
/// trabalho precisa saber quem está com a habilitação vencida. O vencimento é
/// comparado pelo **servidor**, ao listar.
model MemberCertification {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  name           String    @db.VarChar(180)
  issuer         String?   @db.VarChar(180)
  /// Número do certificado, como emitido.
  credentialId   String?   @map("credential_id") @db.VarChar(120)
  issuedAt       DateTime? @map("issued_at") @db.Date
  expiresAt      DateTime? @map("expires_at") @db.Date
  /// Arquivo do certificado no Storage Provider (PR-19). Opcional.
  fileId         String?   @map("file_id") @db.Uuid
  notes          String?   @db.Text
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  file         StorageFile? @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([organizationId, userId, deletedAt])
  @@index([organizationId, expiresAt, deletedAt])
  @@map("member_certifications")
}

/// Equipe operacional. Agrupa pessoas para escala e atribuição.
model Team {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  businessUnitId String?   @map("business_unit_id") @db.Uuid
  leaderUserId   String?   @map("leader_user_id") @db.Uuid
  name           String    @db.VarChar(140)
  slug           String    @db.VarChar(140)
  description    String?   @db.Text
  color          String?   @db.VarChar(40)
  status         String    @default("ACTIVE") @db.VarChar(40)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessUnit BusinessUnit?    @relation(fields: [businessUnitId], references: [id], onDelete: SetNull)
  leader       User?            @relation("TeamLeader", fields: [leaderUserId], references: [id], onDelete: SetNull)
  members      TeamMembership[]

  @@unique([organizationId, slug])
  @@index([organizationId, status, deletedAt])
  @@map("teams")
}

model TeamMembership {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  teamId         String    @map("team_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  /// Papel dentro da equipe (texto livre: "líder técnico", "auxiliar").
  role           String?   @db.VarChar(80)
  joinedAt       DateTime  @default(now()) @map("joined_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team         Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([organizationId, userId, deletedAt])
  @@map("team_memberships")
}

/// Posição reportada por uma pessoa em campo.
///
/// Escrita **apenas pela própria pessoa** (`POST /workforce/me/location`), a
/// partir do aplicativo de campo: ninguém publica a posição de outro. O
/// histórico é mantido porque a última posição sozinha não responde "onde ele
/// esteve durante a visita".
model MemberLocation {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  latitude       Decimal  @db.Decimal(10, 7)
  longitude      Decimal  @db.Decimal(10, 7)
  /// Raio de incerteza em metros, como o dispositivo reportou.
  accuracy       Decimal? @db.Decimal(10, 2)
  /// Origem: MOBILE | WEB | MANUAL — para o consumidor saber o que confiar.
  source         String   @default("MOBILE") @db.VarChar(30)
  /// Quando o dispositivo mediu, que pode ser antes de quando enviou.
  recordedAt     DateTime @map("recorded_at") @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, recordedAt])
  @@index([organizationId, recordedAt])
  @@map("member_locations")
}

// -----------------------------------------------------------------------------
// FINANCIAL CORE
//
// Registro de entradas e saídas de dinheiro. **Não é contabilidade**: não há
// partidas dobradas, plano de contas, conciliação bancária nem apuração
// fiscal. O que existe é o fato financeiro — entrou ou saiu, quanto, quando,
// de que categoria, com que origem.
//
// Todo lançamento pertence a **uma única unidade de negócio**: dinheiro é
// contado por unidade, e um lançamento de duas unidades seria um rateio, que
// é decisão contábil que este domínio não toma.
// -----------------------------------------------------------------------------

/// Categoria de receita ou despesa, customizável pela organização.
///
/// É catálogo, e não texto livre no lançamento, para que dois lançamentos da
/// mesma natureza sejam agrupáveis pela mesma chave — sem isso "Peças" e
/// "peças" seriam categorias diferentes no relatório.
model FinancialCategory {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  /// `INCOME` · `EXPENSE` — uma categoria serve a um lado só.
  type           String    @db.VarChar(20)
  name           String    @db.VarChar(120)
  slug           String    @db.VarChar(120)
  description    String?   @db.Text
  /// Classe de cor sobre tokens do Design System.
  color          String?   @db.VarChar(40)
  /// `true` para as categorias semeadas na primeira abertura do módulo.
  isSystem       Boolean   @default(false) @map("is_system")
  sortOrder      Int       @default(0) @map("sort_order")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entries      FinancialEntry[]

  @@unique([organizationId, type, slug])
  @@index([organizationId, type, deletedAt])
  @@map("financial_categories")
}

/// Lançamento financeiro — uma entrada ou uma saída.
///
/// ## Rastreabilidade da origem
///
/// `source` diz **de onde o fato veio** e `sourceEntityId` aponta para o
/// registro que o originou. Um lançamento de recibo carrega o id do manifest
/// que o emitiu; um manual não carrega nada. É o par que garante que o mesmo
/// recibo nunca vire dois lançamentos — ver o índice único parcial na
/// migração.
///
/// ## Cancelar não é apagar
///
/// `CANCELLED` preserva o fato de que o lançamento existiu e por que deixou de
/// valer. Apagar um valor confirmado destruiria a explicação de um saldo que
/// alguém já viu.
model FinancialEntry {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  /// Obrigatória: dinheiro é contado por unidade.
  businessUnitId String    @map("business_unit_id") @db.Uuid
  categoryId     String?   @map("category_id") @db.Uuid
  /// `INCOME` · `EXPENSE`.
  type           String    @db.VarChar(20)
  /// `PENDING` · `CONFIRMED` · `CANCELLED`.
  status         String    @default("PENDING") @db.VarChar(20)
  /// `MANUAL` · `RECEIPT` · `QUOTE` · `SYSTEM`.
  source         String    @default("MANUAL") @db.VarChar(20)
  /// Registro que originou o lançamento. Nulo em lançamento manual.
  sourceEntityId String?   @map("source_entity_id") @db.Uuid
  amount         Decimal   @db.Decimal(14, 2)
  currency       String    @default("BRL") @db.VarChar(3)
  description    String    @db.VarChar(255)
  notes          String?   @db.Text
  /// Data de competência — quando o fato aconteceu, não quando foi digitado.
  competenceDate DateTime  @map("competence_date") @db.Date
  /// Vencimento previsto, quando faz sentido. Opcional.
  dueDate        DateTime? @map("due_date") @db.Date
  confirmedAt    DateTime? @map("confirmed_at") @db.Timestamptz(3)
  confirmedById  String?   @map("confirmed_by_id") @db.Uuid
  cancelledAt    DateTime? @map("cancelled_at") @db.Timestamptz(3)
  cancelledById  String?   @map("cancelled_by_id") @db.Uuid
  cancelReason   String?   @map("cancel_reason") @db.VarChar(500)
  customerId     String?   @map("customer_id") @db.Uuid
  operationId    String?   @map("operation_id") @db.Uuid
  metadata       Json      @default("{}") @db.JsonB
  createdById    String    @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessUnit BusinessUnit       @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  category     FinancialCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  customer     Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  operation    Operation?         @relation(fields: [operationId], references: [id], onDelete: SetNull)
  createdBy    User               @relation("FinancialEntryCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  confirmedBy  User?              @relation("FinancialEntryConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  cancelledBy  User?              @relation("FinancialEntryCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)

  @@index([organizationId, businessUnitId, competenceDate, deletedAt])
  @@index([organizationId, type, status, competenceDate])
  @@index([organizationId, categoryId, competenceDate])
  @@index([organizationId, customerId])
  @@index([organizationId, operationId])
  @@index([organizationId, source, sourceEntityId])
  @@index([organizationId, status, dueDate])
  @@map("financial_entries")
}

/// Configuração financeira da organização.
///
/// **Não é depósito de flags.** Cada campo aqui muda um comportamento que o
/// servidor de fato executa; um interruptor que ninguém lê não entra.
model FinancialSettings {
  id                 String   @id @default(uuid(7)) @db.Uuid
  organizationId     String   @unique @map("organization_id") @db.Uuid
  /// Recibo oficial emitido vira receita confirmada automaticamente.
  autoRecordReceipts Boolean  @default(true) @map("auto_record_receipts")
  /// Moeda padrão dos lançamentos criados sem moeda explícita.
  defaultCurrency    String   @default("BRL") @map("default_currency") @db.VarChar(3)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("financial_settings")
}

// -----------------------------------------------------------------------------
// COMMERCIAL ENGINE — QUOTES
//
// Proposta comercial: o que se ofereceu, por quanto, até quando. **Não é
// pedido, nem contrato, nem nota fiscal** — é o documento que antecede a
// decisão do cliente, e cuja aprovação passa a valer como receita prevista.
// -----------------------------------------------------------------------------

/// Orçamento.
///
/// ## Dinheiro é do servidor
///
/// `subtotal`, `discount` e `total` são recalculados a cada mudança de item.
/// Nenhum deles é aceito do cliente: um total enviado pela rede é um total que
/// alguém pode escolher.
///
/// ## Conversão é fato, não estado
///
/// Ter virado operação não é um status — é `operationId` preenchido. Um
/// orçamento aprovado e convertido continua aprovado; o que mudou é que existe
/// trabalho a fazer por causa dele.
model Quote {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  businessUnitId String    @map("business_unit_id") @db.Uuid
  customerId     String    @map("customer_id") @db.Uuid
  /// Sequencial por organização, atribuído sob trava — nunca se repete.
  number         Int
  /// Identificador legível derivado do número (`ORC-000042`).
  code           String    @db.VarChar(40)
  /// `DRAFT` · `SENT` · `APPROVED` · `REJECTED` · `EXPIRED` · `CANCELLED`.
  status         String    @default("DRAFT") @db.VarChar(20)
  title          String    @db.VarChar(220)
  notes          String?   @db.Text
  /// Última data em que a proposta vale. Sem hora: validade é dia.
  validUntil     DateTime? @map("valid_until") @db.Date
  currency       String    @default("BRL") @db.VarChar(3)
  /// Soma dos itens. Recalculado pelo servidor.
  subtotal       Decimal   @default(0) @db.Decimal(14, 2)
  /// Desconto sobre o total do orçamento, além dos descontos por item.
  discount       Decimal   @default(0) @db.Decimal(14, 2)
  total          Decimal   @default(0) @db.Decimal(14, 2)

  sentAt        DateTime? @map("sent_at") @db.Timestamptz(3)
  sentById      String?   @map("sent_by_id") @db.Uuid
  /// Momento da decisão do cliente — aprovação ou recusa.
  decidedAt     DateTime? @map("decided_at") @db.Timestamptz(3)
  decidedById   String?   @map("decided_by_id") @db.Uuid
  /// Motivo da recusa ou do cancelamento. Preservado; nunca sobrescrito por edição.
  closingReason String?   @map("closing_reason") @db.VarChar(500)
  expiredAt     DateTime? @map("expired_at") @db.Timestamptz(3)
  cancelledAt   DateTime? @map("cancelled_at") @db.Timestamptz(3)

  /// Operação gerada pela conversão. Nulo enquanto não converteu.
  operationId String?   @unique @map("operation_id") @db.Uuid
  convertedAt DateTime? @map("converted_at") @db.Timestamptz(3)

  metadata    Json      @default("{}") @db.JsonB
  createdById String    @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessUnit BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  operation    Operation?   @relation(fields: [operationId], references: [id], onDelete: SetNull)
  createdBy    User         @relation("QuoteCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  sentBy       User?        @relation("QuoteSentBy", fields: [sentById], references: [id], onDelete: SetNull)
  decidedBy    User?        @relation("QuoteDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  items        QuoteItem[]

  @@unique([organizationId, number])
  @@index([organizationId, businessUnitId, status, createdAt])
  @@index([organizationId, customerId, createdAt])
  @@index([organizationId, status, validUntil])
  @@map("quotes")
}

/// Item de um orçamento — **cópia comercial**, não referência viva.
///
/// Descrição, SKU, unidade e preço são gravados no momento em que o item entra.
/// `catalogItemId` guarda de onde veio, para rastreabilidade, mas o orçamento
/// não o lê para exibir nada: mudar o preço no Catálogo amanhã não pode mudar
/// o que já foi proposto a um cliente — e um preço que muda depois de enviado
/// é uma proposta que ninguém pode honrar.
model QuoteItem {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  quoteId        String   @map("quote_id") @db.Uuid
  /// Origem no Catálogo. `SetNull` para que apagar o produto não apague o item.
  catalogItemId  String?  @map("catalog_item_id") @db.Uuid
  /// `PRODUCT` · `SERVICE` · `PART`, congelado na inclusão.
  kind           String   @default("PRODUCT") @db.VarChar(40)
  description    String   @db.VarChar(255)
  sku            String?  @db.VarChar(80)
  unit           String   @default("UN") @db.VarChar(20)
  /// Três casas: serviço se mede em horas, e meia hora existe.
  quantity       Decimal  @db.Decimal(14, 3)
  unitPrice      Decimal  @map("unit_price") @db.Decimal(14, 2)
  discount       Decimal  @default(0) @db.Decimal(14, 2)
  /// `quantity * unitPrice - discount`, calculado pelo servidor.
  total          Decimal  @db.Decimal(14, 2)
  notes          String?  @db.Text
  position       Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quote        Quote        @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  catalogItem  Product?     @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)

  @@index([quoteId, position])
  @@index([organizationId, catalogItemId])
  @@map("quote_items")
}
