  organizationId String    @map("organization_id") @db.Uuid
  businessUnitId String    @map("business_unit_id") @db.Uuid
  customerId     String?   @map("customer_id") @db.Uuid
  assetId        String?   @map("asset_id") @db.Uuid
  code           String    @db.VarChar(60)
  kind           String    @db.VarChar(60)
  title          String    @db.VarChar(220)
  description    String?   @db.Text
  status         String    @default("OPEN") @db.VarChar(40)
  priority       String    @default("NORMAL") @db.VarChar(30)
  scheduledStart DateTime? @map("scheduled_start") @db.Timestamptz(3)
  scheduledEnd   DateTime? @map("scheduled_end") @db.Timestamptz(3)
  startedAt      DateTime? @map("started_at") @db.Timestamptz(3)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(3)
  location       Json?     @db.JsonB
  data           Json?     @db.JsonB
  createdById    String?   @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
