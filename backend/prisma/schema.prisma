  organization   Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  execution      ArtifactExecution             @relation(fields: [executionId], references: [id], onDelete: Cascade)
  answeredBy     User?                         @relation("ArtifactResponseAnsweredBy", fields: [answeredById], references: [id], onDelete: SetNull)
  attachments    ArtifactExecutionAttachment[]

