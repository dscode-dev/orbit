model SchedulingAvailability {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  businessUnitId String?   @map("business_unit_id") @db.Uuid
  userId         String?   @map("user_id") @db.Uuid
  resourceType   String    @map("resource_type") @db.VarChar(30)
  resourceKey    String?   @map("resource_key") @db.VarChar(160)
  kind           String    @db.VarChar(30)
  dayOfWeek      Int?      @map("day_of_week")
  date           DateTime? @db.Date
  startMinute    Int       @map("start_minute")
  endMinute      Int       @map("end_minute")
  timezone       String    @default("America/Recife") @db.VarChar(64)
  effectiveFrom  DateTime? @map("effective_from") @db.Date
  effectiveUntil DateTime? @map("effective_until") @db.Date
  reason         String?   @db.VarChar(500)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
