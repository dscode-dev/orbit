}

// -----------------------------------------------------------------------------
// REPORTS / DOCUMENT ENGINE / DIGITAL SIGNATURES
// -----------------------------------------------------------------------------

model ReportTemplate {
  id                 String    @id @default(uuid(7)) @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  key                String    @db.VarChar(100)
  name               String    @db.VarChar(180)
  description        String?   @db.Text
  reportKind         String    @map("report_kind") @db.VarChar(60)
  version            Int       @default(1)
  sections           Json      @default("[]") @db.JsonB
  signatureSlots     Json      @default("[]") @map("signature_slots") @db.JsonB
  settings           Json      @default("{}") @db.JsonB
  isDefault          Boolean   @default(false) @map("is_default")
  isActive           Boolean   @default(true) @map("is_active")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(3)
  artifactTemplateId String?   @map("artifact_template_id") @db.Uuid

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reports          Report[]
  artifactTemplate ArtifactTemplate? @relation(fields: [artifactTemplateId], references: [id], onDelete: SetNull)

  @@unique([organizationId, key, version])
  @@index([organizationId, reportKind, isActive, deletedAt])
  @@index([artifactTemplateId])
  @@map("report_templates")
}

model Report {
  id              String    @id @default(uuid(7)) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  businessUnitId  String    @map("business_unit_id") @db.Uuid
  templateId      String    @map("template_id") @db.Uuid
  operationId     String?   @map("operation_id") @db.Uuid
  customerId      String?   @map("customer_id") @db.Uuid
  createdById     String    @map("created_by_id") @db.Uuid
  code            String    @db.VarChar(60)
  title           String    @db.VarChar(220)
  status          String    @default("DRAFT") @db.VarChar(40)
  templateVersion Int       @map("template_version")
  sections        Json      @default("[]") @db.JsonB
  signatureSlots  Json      @default("[]") @map("signature_slots") @db.JsonB
  renderSettings  Json      @default("{}") @map("render_settings") @db.JsonB
  data            Json      @default("{}") @db.JsonB
  contentHash     String    @map("content_hash") @db.Char(64)
  lockedAt        DateTime? @map("locked_at") @db.Timestamptz(3)
  finalizedAt     DateTime? @map("finalized_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessUnit BusinessUnit        @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  template     ReportTemplate      @relation(fields: [templateId], references: [id], onDelete: Restrict)
  operation    Operation?          @relation(fields: [operationId], references: [id], onDelete: SetNull)
  customer     Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdBy    User                @relation("ReportCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  documents    GeneratedDocument[]
