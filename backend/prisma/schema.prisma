  businessUnit BusinessUnit?                  @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  calendar     SchedulingCalendar             @relation(fields: [calendarId], references: [id], onDelete: Restrict)
  customer     Customer?                      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  asset        Asset?                         @relation(fields: [assetId], references: [id], onDelete: SetNull)
  createdBy    User                           @relation("SchedulingEventCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  recurrence   SchedulingRecurrence?
  allocations  SchedulingResourceAllocation[]
  history      SchedulingEventHistory[]

  @@index([organizationId, startsAt, endsAt])
  @@index([organizationId, businessUnitId, startsAt])
  @@index([calendarId, startsAt])
  @@index([customerId, startsAt])
  @@index([assetId, startsAt])
  @@index([sourceModule, sourceEntityType, sourceEntityId])
  @@map("scheduling_events")
}

model SchedulingRecurrence {
  id         String     @id @default(uuid(7)) @db.Uuid
  eventId    String     @unique @map("event_id") @db.Uuid
  frequency  String     @db.VarChar(30)
  interval   Int        @default(1)
  byWeekday  Int[]      @default([]) @map("by_weekday")
  byMonthDay Int?       @map("by_month_day")
  count      Int?
  until      DateTime?  @db.Timestamptz(3)
  customRule Json?      @map("custom_rule") @db.JsonB
  exceptions DateTime[] @default([]) @db.Timestamptz(3)
  timezone   String     @default("America/Recife") @db.VarChar(64)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  event SchedulingEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("scheduling_recurrences")
}

model SchedulingResourceAllocation {
  id           String    @id @default(uuid(7)) @db.Uuid
  eventId      String    @map("event_id") @db.Uuid
  userId       String?   @map("user_id") @db.Uuid
